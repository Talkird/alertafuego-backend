# Copy to backend.hcl (gitignored) and fill in with terraform/bootstrap's outputs,
# or pass the same values as `-backend-config="key=value"` flags (that's what CI does).
bucket         = "alertafuego-tfstate-<account_id>"
key            = "backend.tfstate"
region         = "us-east-1"
dynamodb_table = "alertafuego-tf-lock"
encrypt        = true
